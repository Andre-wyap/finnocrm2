SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
* * * * * root /usr/bin/flock -n /run/lock/finno-whatsapp-worker.lock -c 'worker_secret=$(cat /root/evolution/wa-worker.secret); /usr/bin/curl -fsS -X POST -H "X-Worker-Secret: $worker_secret" https://crm.finnomalaysia.com/api/wa/worker >/dev/null 2>&1'
